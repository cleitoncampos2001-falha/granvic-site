---
/**
 * Botão flutuante de WhatsApp — presente em todas as páginas (05/09).
 * Resolve gap real: no mobile, o CTA "Fale com um especialista" do Header
 * some (vira só o hamburguer) — quem rola a página sem abrir o menu não via
 * nenhum CTA visível. Aparece após leve rolagem, some quando o menu mobile
 * está aberto (evita sobrepor). Só 1 botão — não duplicar com outros CTAs
 * flutuantes.
 */
import { whatsappLink, WHATSAPP } from '../config/site';

const waLink = whatsappLink(WHATSAPP.mensagens.home);
---

{waLink && (
  <a
    id="botao-flutuante-whatsapp"
    href={waLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Falar no WhatsApp"
    class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg opacity-0 translate-y-3 pointer-events-none transition-all duration-300 hover:brightness-105"
  >
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
      <path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.876.52 3.63 1.423 5.13L2 22l4.998-1.31A9.953 9.953 0 0 0 12 22c5.523 0 10-4.478 10-10S17.523 2 12.001 2zm0 18.111a8.09 8.09 0 0 1-4.13-1.13l-.296-.176-3.104.814.828-3.024-.192-.31A8.086 8.086 0 0 1 3.889 12c0-4.472 3.639-8.111 8.112-8.111 4.472 0 8.11 3.639 8.11 8.111 0 4.473-3.638 8.111-8.11 8.111z"></path>
    </svg>
  </a>
)}

<script>
  const botao = document.getElementById('botao-flutuante-whatsapp');
  const drawer = document.getElementById('menu-mobile');

  const atualizar = () => {
    if (!botao) return;
    const menuAberto = drawer && !drawer.classList.contains('hidden');
    const visivel = window.scrollY > 400 && !menuAberto;
    botao.classList.toggle('opacity-0', !visivel);
    botao.classList.toggle('translate-y-3', !visivel);
    botao.classList.toggle('pointer-events-none', !visivel);
  };

  atualizar();
  window.addEventListener('scroll', atualizar, { passive: true });
  new MutationObserver(atualizar).observe(document.body, { attributeFilter: ['class'], subtree: true });
</script>
