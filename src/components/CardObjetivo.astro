---
/**
 * CardObjetivo — cartão de objetivo com imagem, usado na Home (BLOCO 02) e
 * no índice de Soluções (mesmo componente, conforme Mapa de Construção §5).
 * Imagem: placeholder atmosférico com a cena da §9 — a foto real entra no
 * lugar depois (linha "enxuto + imagem seletiva", decisão 13/08). Objetivo é
 * fazer a pessoa visualizar a conquista, não só ler sobre ela.
 */
import type { Objetivo } from '../data/objetivos';

interface Props {
  objetivo: Objetivo;
}
const { objetivo: o } = Astro.props;
const Tag = o.gated ? 'div' : 'a';
---

<Tag
  href={o.gated ? undefined : o.href}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border border-linha bg-white/40 transition-colors',
    o.gated ? 'opacity-80' : 'hover:border-ouro',
  ]}
>
  <!-- Imagem (real quando produzida; senão placeholder atmosférico — cena §9) -->
  <div
    class="relative aspect-[4/3] overflow-hidden"
    style={!o.imagemReal ? `background:
      radial-gradient(85% 70% at 78% 10%, rgba(150,126,89,.4), transparent 55%),
      radial-gradient(120% 120% at 10% 115%, rgba(9,28,40,.95), transparent 62%),
      linear-gradient(125deg,#1b4a5e,#0f2d3e 72%);` : undefined}
  >
    {o.imagemReal && (
      <img src={o.imagemReal} alt={o.cenaImagem} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    )}
    {!o.imagemReal && (
      <>
        <span class="absolute right-2.5 top-2.5 rounded-full bg-black/25 px-2.5 py-1 text-[9px] uppercase tracking-wider text-offwhite/80 border border-offwhite/15">
          Imagem a produzir
        </span>
        <span class="absolute inset-x-3 bottom-2.5 text-[10.5px] leading-snug text-ouro/90">
          {o.cenaImagem}
        </span>
      </>
    )}
    {o.gated && (
      <span class="absolute left-2.5 top-2.5 rounded-full bg-petroleo/70 px-2.5 py-1 text-[9px] uppercase tracking-wider text-offwhite/85">
        Em breve
      </span>
    )}
  </div>

  <!-- Texto -->
  <div class="flex flex-1 flex-col justify-between p-6">
    <div>
      <h3 class="font-display text-xl font-medium text-petroleo">{o.nome}</h3>
      <p class="mt-3 text-[16px] leading-snug italic text-petroleo/85">“{o.dor}”</p>
    </div>
    {!o.gated && (
      <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-petroleo">
        {o.cta}<span class="text-ouro transition-transform group-hover:translate-x-1">→</span>
      </span>
    )}
  </div>
</Tag>
