---
/**
 * Redes sociais — ícones monocromáticos discretos (Mapa §9.2).
 * Renderiza SOMENTE redes com `ativo: true` e `url` preenchida.
 * WhatsApp entra aqui também quando há número configurado.
 */
import { REDES, whatsappLink, WHATSAPP } from '../config/site';

interface Props {
  /** Cor dos ícones — 'clara' sobre fundo escuro, 'escura' sobre off-white */
  tom?: 'clara' | 'escura';
  incluirWhatsapp?: boolean;
  class?: string;
}
const { tom = 'clara', incluirWhatsapp = true, class: klass = '' } = Astro.props;

const cor = tom === 'clara' ? 'text-offwhite/70 hover:text-ouro' : 'text-petroleo/70 hover:text-ouro';

const redes = Object.values(REDES).filter((r) => r.ativo && r.url);
const waLink = incluirWhatsapp ? whatsappLink(WHATSAPP.mensagens.home) : null;
---

{
  (redes.length > 0 || waLink) && (
    <ul class:list={['flex items-center gap-4', klass]}>
      {redes.map((rede) => (
        <li>
          <a
            href={rede.url!}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={rede.label}
            class:list={['inline-flex transition-colors', cor]}
          >
            {rede.label === 'Instagram' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            )}
            {rede.label === 'LinkedIn' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.3 8.65 21 10.9 21 14v7h-4v-6.2c0-1.48-.03-3.38-2.06-3.38-2.06 0-2.38 1.6-2.38 3.27V21H9z" />
              </svg>
            )}
            {rede.label === 'YouTube' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 00-1.76-1.77C19.35 5.1 12 5.1 12 5.1s-7.35 0-8.84.43A2.5 2.5 0 001.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 001.76 1.77C4.65 18.9 12 18.9 12 18.9s7.35 0 8.84-.43a2.5 2.5 0 001.76-1.77C23 15.2 23 12 23 12zM9.75 15.02V8.98L15.5 12z" />
              </svg>
            )}
          </a>
        </li>
      ))}
      {waLink && (
        <li>
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class:list={['inline-flex transition-colors', cor]}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 00-8.6 15.05L2 22l5.1-1.34A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.18-1.15l-.3-.18-3.03.8.81-2.95-.2-.31A8.2 8.2 0 1112 20.2zm4.5-6.14c-.25-.13-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.12-.17.25-.64.8-.79.97-.14.16-.29.18-.54.06a6.7 6.7 0 01-1.97-1.22 7.4 7.4 0 01-1.36-1.7c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42l-.48-.01a.92.92 0 00-.67.31c-.23.25-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.16 1.78 2.72 4.3 3.81.6.26 1.07.41 1.44.53.6.19 1.16.16 1.6.1.48-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.1-.23-.16-.48-.28z" />
            </svg>
          </a>
        </li>
      )}
    </ul>
  )
}
