---
/**
 * GRANVIC PARTNERS (ex-"Seja um Parceiro") — formulário de interesse (09/09).
 * Renomeado a pedido do gestor. Não existe programa de parceria formal com
 * níveis/comissão definidos ainda (10_RECRUTAMENTO_E_EXPANSAO/ vazio) — não
 * inventar critérios. As duas frentes de interesse listadas (indicação de
 * clientes / representação comercial) são genéricas e já implícitas no
 * modelo da GRANVIC (Política de Privacidade §5 já cita "consultores e
 * parceiros credenciados"), não uma estrutura nova inventada aqui.
 * Mesmo padrão de formulário/backend de /contato e /trabalhe-conosco.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { FORM_ENDPOINT, JURIDICO, whatsappLink, WHATSAPP } from '../config/site';

const waLink = whatsappLink(WHATSAPP.mensagens.home);

const tipos = ['Indicação de clientes', 'Representação comercial', 'Outro tipo de parceria'];
---

<BaseLayout
  titulo="GRANVIC Partners"
  descricao="Tem uma rede — contábil, imobiliária, empresarial — ou já atua no mercado de consórcio? Conheça o GRANVIC Partners."
>
  <section class="container-site pt-20 pb-20 md:pt-28 md:pb-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start max-w-5xl">
      <div>
        <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-ouro font-semibold">GRANVIC Partners</p>
        <h1 class="mt-5 font-display font-medium text-3xl md:text-5xl leading-[1.1] text-petroleo text-balance">
          Sua rede pode virar patrimônio pros seus clientes.
        </h1>
        <p class="mt-7 text-lg text-petroleo-soft leading-relaxed max-w-md">
          Se você já tem uma rede — contábil, imobiliária, empresarial — ou já atua no mercado de consórcio, e quer conversar sobre parceria com a GRANVIC, deixe seu contato. Os critérios formais do programa ainda estão em estruturação — mas conversamos com você desde já.
        </p>
        {waLink && (
          <p class="mt-8 text-sm text-petroleo-soft">
            Prefere falar agora? <a href={waLink} target="_blank" rel="noopener noreferrer" class="text-petroleo font-semibold underline decoration-ouro underline-offset-2">Chame no WhatsApp</a>.
          </p>
        )}
      </div>

      <div class="rounded-3xl border border-linha bg-white/50 p-7 md:p-9">
        {FORM_ENDPOINT ? (
          <form id="form-partners" class="space-y-5">
            <div>
              <label for="nome" class="block text-sm font-medium text-petroleo mb-1.5">Nome</label>
              <input type="text" id="nome" name="nome" required class="w-full rounded-xl border border-linha bg-offwhite px-4 py-3 text-petroleo focus:outline-none focus:ring-2 focus:ring-ouro" />
            </div>
            <div>
              <label for="empresa" class="block text-sm font-medium text-petroleo mb-1.5">Empresa/rede (opcional)</label>
              <input type="text" id="empresa" name="empresa" class="w-full rounded-xl border border-linha bg-offwhite px-4 py-3 text-petroleo focus:outline-none focus:ring-2 focus:ring-ouro" />
            </div>
            <div>
              <label for="contato" class="block text-sm font-medium text-petroleo mb-1.5">Telefone ou e-mail</label>
              <input type="text" id="contato" name="contato" required class="w-full rounded-xl border border-linha bg-offwhite px-4 py-3 text-petroleo focus:outline-none focus:ring-2 focus:ring-ouro" />
            </div>
            <div>
              <label for="tipo" class="block text-sm font-medium text-petroleo mb-1.5">Tipo de parceria de interesse</label>
              <select id="tipo" name="tipo" class="w-full rounded-xl border border-linha bg-offwhite px-4 py-3 text-petroleo focus:outline-none focus:ring-2 focus:ring-ouro">
                {tipos.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="mensagem" class="block text-sm font-medium text-petroleo mb-1.5">Conte um pouco sobre sua rede (opcional)</label>
              <textarea id="mensagem" name="mensagem" rows="4" class="w-full rounded-xl border border-linha bg-offwhite px-4 py-3 text-petroleo focus:outline-none focus:ring-2 focus:ring-ouro"></textarea>
            </div>
            <input type="hidden" id="origem" name="origem" value="/parceiros (GRANVIC Partners)" />
            <button type="submit" class="w-full rounded-full bg-petroleo px-7 py-3.5 text-base font-medium text-offwhite hover:brightness-110 transition">
              Enviar interesse
            </button>
            <p class="text-xs text-petroleo-soft/80 leading-relaxed">
              Ao enviar, você concorda com o tratamento dos seus dados conforme a nossa <a href="/politica-de-privacidade" class="underline decoration-ouro underline-offset-2">Política de Privacidade</a>.
            </p>
            <p id="form-status" class="text-sm hidden" role="status"></p>
          </form>
        ) : (
          <div>
            <p class="text-petroleo font-medium">O formulário ainda está sendo configurado.</p>
            <p class="mt-3 text-[15px] text-petroleo-soft leading-relaxed">
              Enquanto isso, fale direto com a gente:
              {waLink && <> <a href={waLink} target="_blank" rel="noopener noreferrer" class="text-petroleo font-semibold underline decoration-ouro underline-offset-2">WhatsApp</a> ou</>}
              {' '}<a href={`mailto:${JURIDICO.emailInstitucional}`} class="text-petroleo font-semibold underline decoration-ouro underline-offset-2">{JURIDICO.emailInstitucional}</a>.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  {FORM_ENDPOINT && (
    <script define:vars={{ FORM_ENDPOINT }}>
      const form = document.getElementById('form-partners');
      const status = document.getElementById('form-status');
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Enviando…';
        try {
          await fetch(FORM_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            body: new FormData(form),
          });
          form.reset();
          status.textContent = 'Recebemos seu interesse em parceria. Entramos em contato em breve.';
          status.className = 'text-sm text-petroleo font-medium';
          status.classList.remove('hidden');
          btn.textContent = 'Enviado';
        } catch (err) {
          status.textContent = 'Não foi possível enviar agora. Tente novamente ou chame no WhatsApp.';
          status.className = 'text-sm text-red-700';
          status.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Enviar interesse';
        }
      });
    </script>
  )}
</BaseLayout>
