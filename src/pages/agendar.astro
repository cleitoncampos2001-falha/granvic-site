---
/**
 * AGENDAR — widget de calendário embutido (Cal.com), 04/09.
 * Pedido do gestor: dar um jeito de agendar a primeira conversa direto no
 * site, sem depender só do WhatsApp. Cal.com escolhido por ser o caminho
 * mais rápido (embed pronto, plano gratuito) — sem IA envolvida (IA de
 * atendimento foi deliberadamente adiada pra sessão própria, ver PENDENCIAS).
 * CAL_LINK em config/site.ts fica null até o gestor criar a conta/evento —
 * até lá, fallback honesto de WhatsApp/e-mail (mesmo padrão de degradação
 * graciosa do WHATSAPP/FORM_ENDPOINT).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CAL_LINK, JURIDICO, whatsappLink, WHATSAPP } from '../config/site';

const waLink = whatsappLink(WHATSAPP.mensagens.home);
---

<BaseLayout
  titulo="Agendar uma Conversa"
  descricao="Escolha um horário para a primeira conversa com um especialista da GRANVIC."
>
  <section class="container-site pt-20 pb-8 md:pt-28 md:pb-10">
    <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-ouro font-semibold">Agendar</p>
    <h1 class="mt-5 font-display font-medium text-3xl md:text-5xl leading-[1.1] text-petroleo max-w-2xl text-balance">
      Escolha o melhor horário para a primeira conversa.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-petroleo-soft leading-relaxed">
      Sem proposta e sem apresentação de produto — é o espaço para entender o seu caso.
    </p>
  </section>

  <section class="container-site pb-20 md:pb-28">
    {CAL_LINK ? (
      <div id="cal-inline" class="w-full min-h-[600px] rounded-3xl border border-linha bg-white/50 overflow-hidden" />
    ) : (
      <div class="max-w-xl rounded-3xl border border-linha bg-white/50 p-8">
        <p class="text-petroleo font-medium">O agendamento online ainda está sendo configurado.</p>
        <p class="mt-3 text-[15px] text-petroleo-soft leading-relaxed">
          Enquanto isso, marcamos direto com você:
          {waLink && <> <a href={waLink} target="_blank" rel="noopener noreferrer" class="text-petroleo font-semibold underline decoration-ouro underline-offset-2">WhatsApp</a> ou</>}
          {' '}<a href={`mailto:${JURIDICO.emailInstitucional}`} class="text-petroleo font-semibold underline decoration-ouro underline-offset-2">{JURIDICO.emailInstitucional}</a>.
        </p>
      </div>
    )}
  </section>

  {CAL_LINK && (
    <script define:vars={{ CAL_LINK }} is:inline>
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ['initNamespace', namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', {
        elementOrSelector: '#cal-inline',
        calLink: CAL_LINK,
        config: { layout: 'month_view' },
      });
      Cal('ui', { hideEventTypeDetails: false, layout: 'month_view' });
    </script>
  )}
</BaseLayout>
