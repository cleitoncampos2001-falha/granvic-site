---
/**
 * HOME — PÁGINA 01 · VERSÃO CURTA (13/08 — reduzir nº de blocos, não só texto).
 * 4 seções: Hero · Objetivos · Diferencial+Jornada (fundidos) · CTA.
 * Consórcio e "Simulação (início)" saíram da Home — vivem em Planejamento
 * Patrimonial e FAQ (contrapeso obrigatório do consórcio preservado lá).
 * Direção visual B+C mantida. Sincronizar SITE_GRANVIC_CONTEUDO.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import DiagramaJornada from '../components/DiagramaJornada.astro';
import CardObjetivo from '../components/CardObjetivo.astro';
import { objetivos } from '../data/objetivos';
import { whatsappLink, WHATSAPP } from '../config/site';

const diagnostico = whatsappLink(WHATSAPP.mensagens.home) ?? '/contato';
const diagExterno = diagnostico.startsWith('http');

const diferenciais = [
  { n: '01', t: 'Entendemos', d: 'Antes de qualquer recomendação, um diagnóstico do seu patrimônio.' },
  { n: '02', t: 'Planejamos', d: 'Você recebe um plano — não uma proposta. E ele é seu.' },
  { n: '03', t: 'Acompanhamos', d: 'Revisado ao longo dos anos. Patrimônio se constrói em décadas.' },
];
---

<BaseLayout
  titulo="GRANVIC — Planejamento Patrimonial Baseado em Ativos"
  descricao="Transforme renda em patrimônio com diagnóstico, plano e acompanhamento. A GRANVIC ajuda pessoas, profissionais e empresas a construir patrimônio com estratégia."
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden text-offwhite" style="background:radial-gradient(120% 120% at 80% 15%, #1b4a5e 0%, #0f2d3e 58%)">
    <img src="/brand/logo_simbolo/granvic_simbolo_branco.png" alt="" aria-hidden="true" class="pointer-events-none select-none absolute -right-16 top-1/2 -translate-y-1/2 w-[min(48vw,560px)] opacity-[0.07]" />
    <div class="container-site relative py-24 md:py-36">
      <div class="max-w-3xl">
        <p class="text-xs md:text-sm uppercase tracking-[0.22em] text-ouro font-semibold">Planejamento Patrimonial Baseado em Ativos</p>
        <h1 class="mt-6 font-display font-medium text-4xl md:text-6xl leading-[1.05] text-balance">
          Estratégia que vira patrimônio.<br />Patrimônio que vira legado.
        </h1>
        <p class="mt-7 text-lg md:text-xl text-offwhite/75 max-w-2xl leading-relaxed">
          Ajudamos você a transformar renda em ativos — com diagnóstico, plano e acompanhamento de longo prazo.
        </p>
        <p class="mt-8 flex items-start gap-3 text-base text-offwhite/85 max-w-xl">
          <span class="mt-2 h-px w-8 shrink-0 bg-ouro" aria-hidden="true"></span>
          <span><strong class="font-semibold text-offwhite">Mais de 30 anos dentro do mercado de consórcio.</strong> Agora, a serviço do seu patrimônio.</span>
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href={diagnostico} {...(diagExterno ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="inline-flex items-center justify-center rounded-full bg-ouro px-8 py-4 text-base font-semibold text-petroleo hover:brightness-105 transition">
            Começar pelo diagnóstico
          </a>
          <a href="/simulacao" class="inline-flex items-center justify-center rounded-full border border-offwhite/30 px-8 py-4 text-base font-medium text-offwhite hover:bg-offwhite/10 transition">
            Comparar as formas de conquistar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OBJETIVOS (hook: a dor primeiro) ============ -->
  <section class="container-site py-20 md:py-28">
    <div class="max-w-2xl">
      <hr class="fio-ouro mb-7" />
      <h2 class="font-display text-3xl md:text-4xl font-medium text-petroleo text-balance">O que você quer conquistar?</h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {objetivos.map((o) => <CardObjetivo objetivo={o} />)}
    </div>
  </section>

  <!-- ============ DIFERENCIAL + JORNADA (fundidos) ============ -->
  <section class="border-t border-linha bg-[#efe8db]/50">
    <div class="container-site py-20 md:py-28">
      <div class="max-w-3xl">
        <hr class="fio-ouro mb-7" />
        <h2 class="font-display text-3xl md:text-[2.4rem] font-medium leading-tight text-petroleo text-balance">
          A diferença não está no que vendemos. Está na ordem em que trabalhamos.
        </h2>
      </div>
      <div class="relative mt-12 grid gap-8 md:grid-cols-3">
        <div class="pointer-events-none absolute left-0 right-0 top-[13px] hidden h-px bg-linha md:block" aria-hidden="true"></div>
        {diferenciais.map((d) => (
          <div class="relative">
            <span class="relative z-10 grid h-7 w-7 place-items-center rounded-full bg-petroleo text-xs font-semibold text-offwhite">{d.n}</span>
            <h3 class="mt-5 font-display text-xl font-medium text-petroleo">{d.t}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-petroleo-soft">{d.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-16 max-w-4xl mx-auto">
        <p class="text-center text-xs uppercase tracking-[0.18em] text-ouro font-semibold mb-7">O caminho</p>
        <DiagramaJornada tom="claro" />
      </div>
      <div class="mt-14 text-center">
        <a href="/planejamento-patrimonial" class="inline-flex items-center gap-1.5 text-base font-semibold text-petroleo border-b border-ouro pb-1">Como trabalhamos <span class="text-ouro">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  <CTABlock
    titulo="Todo patrimônio começa com uma decisão. Normalmente, a de olhar de frente."
    texto="A primeira conversa não tem proposta nem apresentação de produto. Você sai sabendo mais sobre o seu patrimônio — contratando algo ou não."
    ctaPrimarioLabel="Falar com um especialista GRANVIC"
    ctaPrimarioHref={diagnostico}
    ctaSecundarioLabel="Chamar no WhatsApp"
    ctaSecundarioHref={diagnostico}
  />
</BaseLayout>
